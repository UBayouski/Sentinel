{
  "name": "context-diff",
  "version": "0.1.0",
  "description": "Detect when a change (e.g. a Jira issue edit) makes sections of a document outdated. Section-level ADF parsing, change normalization, relevance prefilter and a provider-agnostic LLM check runner.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "keywords": ["atlassian", "forge", "confluence", "jira", "adf", "documentation", "llm", "drift"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
